    {
      "province": "ID_KR",
      "text": {
        "en": "Raja Ali Haji wrote Gurindam Dua Belas on Penyengat Island, an important place in Malay literary history.",
        "id": "Raja Ali Haji menulis Gurindam Dua Belas di Pulau Penyengat, tempat penting dalam sejarah sastra Melayu.",
        "ja": "ラジャ・アリ・ハジは、マレー文学史にゆかりの深いプニェンガット島で『グリンダム十二章』を執筆しました。"
      },
      "source": "https://id.wikipedia.org/wiki/Gurindam_Dua_Belas"
    },
    {
      "province": "ID_KR",
      "text": {
        "en": "Barelang is a chain of six bridges linking Batam with nearby islands, including Rempang and Galang.",
        "id": "Barelang merupakan rangkaian enam jembatan yang menghubungkan Batam dengan pulau sekitar, termasuk Rempang dan Galang.",
        "ja": "バレランは、バタム島とルンパン島、ガラン島などを結ぶ六つの橋の総称です。"
      },
      "source": "https://en.wikipedia.org/wiki/Barelang_Bridge"
    },
