  "facts": [
    {
      "province": "ID_ST",
      "text": {
        "en": "Barkcloth-making survives among communities in Central Sulawesi.",
        "id": "Tradisi pembuatan kain kulit kayu masih hidup di sejumlah komunitas Sulawesi Tengah.",
        "ja": "中スラウェシの一部の共同体には樹皮布の製作が伝わっています。"
      },
      "source": "https://mongabay.co.id/2022/12/06/kain-kulit-kayu-pakaian-tradisional-dari-lembah-bada/"
    },
    {
      "province": "ID_ST",
      "text": {
        "en": "Barkcloth has different local names: ranta in Bada, kumpe or mbesa in Kulawi, hampi in Napu, and inodo in Besoa.",
        "id": "Kain kulit kayu disebut ranta di Bada, kumpe atau mbesa di Kulawi, hampi di Napu, dan inodo di Besoa.",
        "ja": "樹皮布はバダではランタ、クラウィではクンペまたはンベサ、ナプではハンピ、ベソアではイノドと呼ばれます。"
      },
      "source": "https://mongabay.co.id/2022/12/06/kain-kulit-kayu-pakaian-tradisional-dari-lembah-bada/"
    },
    {
      "province": "ID_ST",
      "text": {
        "en": "Kaledo is often eaten with boiled cassava rather than rice.",
        "id": "Kaledo kerap disantap bersama singkong rebus sebagai pengganti nasi.",
        "ja": "カレドには、米飯の代わりに茹でたキャッサバを添えることがあります。"
      },
      "source": "https://www.indonesia.travel/id/id/travel-ideas/gastronomy/makanan-khas-sulawesi-tengah"
    }
  ]
