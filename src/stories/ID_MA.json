    {
      "province": "ID_MA",
      "text": {
        "en": "Cele clothing often uses small checks or geometric stripes.",
        "id": "Busana cele kerap menggunakan kotak kecil atau garis geometris.",
        "ja": "チェレの服には、小さな格子や幾何学的な縞がよく使われます。"
      },
      "source": "https://id.wikipedia.org/wiki/Baju_Cele"
    },
    {
      "province": "ID_MA",
      "text": {
        "en": "Totobuang are small gongs, while tifa are drums; together they form a Maluku ensemble.",
        "id": "Totobuang adalah gong kecil, sedangkan tifa adalah gendang; keduanya membentuk ansambel Maluku.",
        "ja": "トトブアンは小さなゴング、ティファは太鼓で、ともにマルクの合奏を構成します。"
      },
      "source": "https://id.wikipedia.org/wiki/Tifa_totobuang"
    },
    {
      "province": "ID_MA",
      "text": {
        "en": "Lenso means handkerchief, the cloth used as a prop in the dance.",
        "id": "Lenso berarti saputangan, kain yang menjadi properti dalam tarian tersebut.",
        "ja": "レンソとはハンカチのことで、踊りの小道具として使われます。"
      },
      "source": "https://id.wikipedia.org/wiki/Tari_Lenso"
