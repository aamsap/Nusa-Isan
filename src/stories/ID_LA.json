  "facts": [
    {
      "province": "ID_LA",
      "text": {
        "en": "Tapis cloth is decorated with intricate embroidery, often with gold-coloured thread.",
        "id": "Kain tapis dihiasi sulaman rumit, sering kali dengan benang berwarna emas.",
        "ja": "タピス布は金色の糸などによる精緻な刺繍が特徴です。"
      },
      "source": "https://id.wikipedia.org/wiki/Tapis"
    },
    {
      "province": "ID_LA",
      "text": {
        "en": "Siger crowns typically have seven or nine points, reflecting different Lampung traditions.",
        "id": "Mahkota siger umumnya memiliki tujuh atau sembilan lekukan, mencerminkan perbedaan tradisi Lampung.",
        "ja": "シゲルの冠には通常七つまたは九つの突起があり、ランプンの伝統の違いを表しています。"
      },
      "source": "https://en.wikipedia.org/wiki/Lampung"
    },
    {
      "province": "ID_LA",
      "text": {
        "en": "Lampung became a separate province from South Sumatra in 1964.",
        "id": "Lampung menjadi provinsi tersendiri setelah terpisah dari Sumatera Selatan pada 1964.",
        "ja": "ランプンは1964年に南スマトラから分かれ、独立した州となりました。"
      },
      "source": "https://en.wikipedia.org/wiki/Lampung"
    }
  ]
