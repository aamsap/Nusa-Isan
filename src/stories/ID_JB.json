    {
      "province": "ID_JB",
      "text": {
        "en": "Jaipongan developed in West Java as an energetic modern performance tradition.",
        "id": "Jaipongan berkembang di Jawa Barat sebagai tradisi pertunjukan yang dinamis.",
        "ja": "ジャイポンガンは西ジャワで発展した躍動的な芸能です。"
      },
      "source": "https://www.indonesia.travel/gb/en/travel-ideas/culture/tari-jaipong"
    },
    {
      "province": "ID_JB",
      "text": {
        "en": "Indonesian Angklung was inscribed on UNESCO’s Representative List of Intangible Cultural Heritage in 2010.",
        "id": "Angklung Indonesia masuk Daftar Representatif Warisan Budaya Takbenda UNESCO pada 2010.",
        "ja": "インドネシアのアンクルンは、2010年にユネスコ無形文化遺産の代表一覧表に記載されました。"
      },
      "source": "https://ich.unesco.org/en/RL/indonesian-angklung-00393"
    },
    {
      "province": "ID_JB",
      "text": {
        "en": "Udjo Ngalagena and Uum Sumiyati founded Saung Angklung Udjo in Bandung in 1966 to preserve Sundanese arts.",
        "id": "Udjo Ngalagena dan Uum Sumiyati mendirikan Saung Angklung Udjo di Bandung pada 1966 untuk melestarikan seni Sunda.",
        "ja": "ウジョ・ンガラゲナとウム・スミヤティは、スンダ芸能を守るため、1966年にバンドンでサウン・アンクルン・ウジョを設立しました。"
      },
      "source": "https://www.indonesia.travel/gb/en/travel-ideas/adventure/bandung---saung-mang-udjo"
